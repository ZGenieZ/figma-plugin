{
  "compilerOptions": {
    "target": "es5",
    "lib": ["es6", "dom"],
    "typeRoots": ["./node_modules/@types", "./node_modules/@figma", "src/@types"],
    "jsx": "react",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/public/*": ["public/*"],
      "@/plugin/*": ["src/plugin/*"],
      "@/shared/*": ["src/shared/*"],
      "@/ui/*": ["src/ui/*"],
    }
  },
  "include": ["src/**/*", "src/shared/types/images.d.ts"]
}
